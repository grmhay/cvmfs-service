# Nested catalogs for nix.hayweb.org (installed at /cvmfs/<repo>/.cvmfsdirtab).
# One catalog per store path: a client loads only the catalogs for the paths
# it touches, so the root catalog stays small as the store grows.
/nix/store/*
/cache/*
/profiles/*/*
# .links is Nix's hardlink directory, not a store path. A marker there is a
# single-link file in the read-only branch, and every host's GC failed trying
# to remove it.
! /nix/store/.links
