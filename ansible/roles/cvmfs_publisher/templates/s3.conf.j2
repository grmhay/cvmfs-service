# Managed by cvmfs-service (role cvmfs_publisher). Upstream storage = MinIO.
CVMFS_S3_HOST={{ cvmfs_s3_host }}
CVMFS_S3_BUCKET={{ cvmfs_s3_bucket }}
CVMFS_S3_ACCESS_KEY={{ publisher_secrets.minio_access_key }}
CVMFS_S3_SECRET_KEY={{ publisher_secrets.minio_secret_key }}
CVMFS_S3_USE_HTTPS=true
CVMFS_S3_DNS_BUCKETS=false
CVMFS_S3_MAX_NUMBER_OF_PARALLEL_CONNECTIONS=16
