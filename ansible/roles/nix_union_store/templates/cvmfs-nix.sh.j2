# Managed by cvmfs-service. Group Profile for this host:
#   channel={{ nix_channel }} group={{ nix_group }} system={{ nix_system }}
# The symlink target is a /nix/store path; on a union host that resolves
# through the Union Store, on a thin host through the bind mount.
{% if cvmfs_nix_mode == "cache" %}
_fleet_bin=/nix/var/nix/profiles/fleet/bin
{% else %}
_fleet_bin={{ nix_profile_link }}/bin
{% endif %}
case ":$PATH:" in *":$_fleet_bin:"*) ;; *) PATH="$_fleet_bin:$PATH" ;; esac
export PATH
unset _fleet_bin
